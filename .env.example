# ─────────────────────────────────────────────────────────────
#  Template for .env — copy this file to `.env` and fill in real values.
#  Safe to commit/share (contains no real secrets).
#    PowerShell:  Copy-Item .env.example .env
# ─────────────────────────────────────────────────────────────

ANTHROPIC_API_KEY=sk-ant-...

# Alt LLM providers (set the one your LLM_TASKS points at, in config.py)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
OLD_WP_APP_PASSWORD=
NEW_WP_APP_PASSWORD=

# LLM provider (optional). Uncomment to route cheap calls to a local Ollama server:
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1
